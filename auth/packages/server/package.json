{
  "name": "@basalt/auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "basalt-auth-server": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/db/migrations dist/db/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate-cli.js"
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
