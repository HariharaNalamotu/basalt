# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -hex 32

# Superuser. Only the migrate tool uses this, never the Data block.
POSTGRES_PASSWORD=

# The Data service's login. It can only call basalt.api().
BASALT_DATA_PASSWORD=

# Shared with the auth service (Supabase Auth GOTRUE_JWT_SECRET). The Data block never sees it.
BASALT_JWT_SECRET=

# Optional. The auth service's issuer, like https://your-site/auth/v1. Checked when set.
BASALT_JWT_ISSUER=

# Same passwords as above, written out in full.
BASALT_ADMIN_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:54329/postgres
BASALT_DATA_URL=postgres://basalt_data:<BASALT_DATA_PASSWORD>@127.0.0.1:54329/postgres
