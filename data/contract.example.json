{
  "tables": {
    "bookings": {
      "fields": {
        "service": { "type": "text", "required": true, "maxLength": 100 },
        "starts_at": { "type": "timestamp", "required": true },
        "phone": { "type": "text", "maxLength": 20, "pattern": "^\\+?[0-9 ()-]{7,20}$" },
        "note": { "type": "text", "maxLength": 1000 },
        "party_size": { "type": "integer", "min": 1, "max": 20 }
      }
    }
  }
}
