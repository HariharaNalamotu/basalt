# Copy to .env and fill in. Never commit .env.

# Superuser connection to the postgres database on the Basalt server.
CLOUD_ADMIN_URL=postgres://postgres:<password>@127.0.0.1:54329/postgres

# Host and port apps' data logins connect to.
CLOUD_DB_HOST=127.0.0.1:54329

# Encrypts each app's database password and signing secret. openssl rand -hex 32
CLOUD_MASTER_KEY=

# The address people and Claude reach Basalt Cloud at.
PUBLIC_URL=http://127.0.0.1:8790

# Set to 1 when running behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=
